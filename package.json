{
  "name": "nex4-lms-api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.9 <12"
  },
  "scripts": {
    "build": "npm run db:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.prisma\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "owner:provision": "tsx src/scripts/provision-owner.ts",
    "owner:mfa:generate": "tsx src/scripts/generate-owner-mfa.ts",
    "worker": "tsx src/worker.ts",
    "jobs:schedule": "tsx src/jobs/schedule-lifecycle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@nestjs/bullmq": "latest",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "latest",
    "@nestjs/throttler": "latest",
    "@prisma/client": "6.12.0",
    "argon2": "latest",
    "bullmq": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "helmet": "latest",
    "ioredis": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "resend": "latest",
    "rxjs": "latest",
    "stripe": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "jest": "latest",
    "prettier": "latest",
    "prisma": "6.12.0",
    "source-map-support": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-loader": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "@prisma/client@6.12.0": true
  }
}
